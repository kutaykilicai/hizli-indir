{
  "manifest_version": 3,
  "name": "Hızlı İndir Tarayıcı Eklentisi",
  "short_name": "Hızlı İndir",
  "version": "1.1.0",
  "description": "İndirmeleri ve sayfadaki videoları Hızlı İndir'e gönderir.",
  "author": "Kutay Kılıç",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Hızlı İndir", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["downloads", "nativeMessaging", "cookies", "contextMenus", "storage", "webRequest", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true }
  ]
}
