<Window x:Class="HizliIndir.UI.SchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zamanlayıcı ve kuyruklar" Width="820" Height="600" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Yeni kuyruk" Margin="0,0,6,0" Click="NewQueue_Click"/>
                <Button x:Name="DeleteBtn" Content="Sil" Click="DeleteQueue_Click"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="Kuyruklar" Style="{StaticResource Subtitle}" Margin="8,0,0,6"/>
            <ListBox x:Name="Queues" Style="{StaticResource SideList}" DisplayMemberPath="Name" SelectionChanged="Queue_Changed"/>
        </DockPanel>
        <DockPanel Grid.Column="1">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBox x:Name="NameBox" Width="240" FontSize="15" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                <Border Style="{StaticResource PillGroup}" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Pill}" Content="Zamanlama" GroupName="t" IsChecked="True" Tag="s" Checked="Tab_Checked"/>
                        <RadioButton Style="{StaticResource Pill}" Content="Kuyruktaki dosyalar" GroupName="t" Tag="f" Checked="Tab_Checked"/>
                    </StackPanel>
                </Border>
            </DockPanel>
            <Grid>
                <ScrollViewer x:Name="ScheduleTab" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox x:Name="EnabledBox" Content="Kuyruğu bu saatte başlat" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="26,8,0,0">
                                    <TextBox x:Name="StartBox" Width="80"/>
                                    <TextBlock Text="(SS:dd)" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="26,10,0,0">
                                    <RadioButton x:Name="OnceRadio" Content="Bir kez, şu gün:" GroupName="once"/>
                                    <TextBox x:Name="OnceDate" Width="120" HorizontalAlignment="Left" Margin="26,4,0,6"/>
                                    <RadioButton x:Name="DailyRadio" Content="Her hafta şu günlerde:" GroupName="once"/>
                                    <WrapPanel x:Name="Days" Margin="26,6,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox x:Name="StopBox" Content="Kuyruğu bu saatte durdur" FontWeight="SemiBold"/>
                                <TextBox x:Name="StopTimeBox" Width="80" HorizontalAlignment="Left" Margin="26,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,2"><TextBox x:Name="ParallelBox" Width="70" DockPanel.Dock="Right"/><TextBlock Text="Aynı anda indirilecek dosya sayısı" VerticalAlignment="Center"/></DockPanel>
                                <DockPanel Margin="0,6"><TextBox x:Name="RetryBox" Width="70" DockPanel.Dock="Right"/><TextBlock Text="Başarısız dosyayı yeniden deneme sayısı" VerticalAlignment="Center"/></DockPanel>
                                <DockPanel Margin="0,6"><ComboBox x:Name="PostBox" Width="220" DockPanel.Dock="Right"/><TextBlock Text="Kuyruk bitince" VerticalAlignment="Center"/></DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <DockPanel x:Name="FilesTab" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0">
                        <Button Content="Yukarı" Margin="0,0,0,6" Click="Up_Click"/>
                        <Button Content="Aşağı" Margin="0,0,0,6" Click="Down_Click"/>
                        <Button Content="Kuyruktan çıkar" Click="RemoveFromQueue_Click"/>
                    </StackPanel>
                    <Border Style="{StaticResource Card}" Padding="4">
                        <ListView x:Name="Files">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Dosya" Width="260" DisplayMemberBinding="{Binding FileName}"/>
                                    <GridViewColumn Header="Boyut" Width="90" DisplayMemberBinding="{Binding SizeText}"/>
                                    <GridViewColumn Header="Durum" Width="130" DisplayMemberBinding="{Binding StatusText}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </DockPanel>
            </Grid>
        </DockPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Şimdi başlat" Margin="0,0,8,0" Click="StartNow_Click"/>
            <Button Content="Durdur" Margin="0,0,8,0" Click="StopNow_Click"/>
            <Button Content="Uygula" Margin="0,0,8,0" Click="Apply_Click"/>
            <Button Content="Kapat" IsDefault="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
