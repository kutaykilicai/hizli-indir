<Window x:Class="HizliIndir.UI.VideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video indir" Width="600" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True">
    <StackPanel Margin="20">
        <DockPanel>
            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource Selected}" Margin="0,0,14,0">
                <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource Accent}"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Video indir" Style="{StaticResource Title}" FontSize="18" MaxWidth="490"/>
                <TextBlock x:Name="UrlText" Style="{StaticResource Caption}" Margin="0,2,0,0" MaxWidth="490"/>
            </StackPanel>
        </DockPanel>
        <TextBlock Text="Kalite" Style="{StaticResource Subtitle}" Margin="0,18,0,8"/>
        <Border Style="{StaticResource PillGroup}">
            <WrapPanel x:Name="Qualities" MaxWidth="560"/>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Kayıt yeri" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
                <TextBox x:Name="FolderBox" Grid.Column="1"/>
                <Button Grid.Column="2" Content="Gözat" Margin="8,0,0,0" Click="Browse_Click"/>
            </Grid>
        </Border>
        <TextBlock x:Name="ToolsText" Style="{StaticResource Caption}" Margin="2,10,0,0" TextWrapping="Wrap"/>
        <DockPanel Margin="0,18,0,0">
            <Button Content="Sonra indir" Click="Later_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Vazgeç" IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="İndirmeyi başlat" IsDefault="True" Click="Start_Click"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
