<Window x:Class="HizliIndir.UI.AddUrlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adres ekle" Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Topmost="True">
    <StackPanel Margin="20">
        <TextBlock Text="Yeni indirme" Style="{StaticResource Title}"/>
        <TextBlock Text="İndirilecek dosyanın, video sayfasının ya da magnet bağlantısının adresini girin." Style="{StaticResource Caption}" Margin="0,4,0,14"/>
        <TextBox x:Name="UrlBox" TextChanged="Url_Changed"/>
        <CheckBox x:Name="AuthBox" Content="Yetkilendirme kullan" Margin="0,12,0,0" Checked="Auth_Changed" Unchecked="Auth_Changed"/>
        <Grid x:Name="AuthPanel" Margin="26,6,0,0" IsEnabled="False">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Kullanıcı adı" Style="{StaticResource Caption}" Margin="0,0,0,4"/><TextBox x:Name="UserBox"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Şifre" Style="{StaticResource Caption}" Margin="0,0,0,4"/><PasswordBox x:Name="PassBox"/></StackPanel>
        </Grid>
        <TextBlock x:Name="Hint" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Vazgeç" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="OkBtn" Content="Devam" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
