<Window x:Class="HizliIndir.UI.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hızlı İndir" Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True">
    <StackPanel Margin="20">
        <TextBlock x:Name="Head" Style="{StaticResource Title}" FontSize="18"/>
        <TextBlock x:Name="Body" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Şimdi yap" Margin="0,0,8,0" Click="Now_Click"/>
            <Button Content="Vazgeç" IsDefault="True" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
