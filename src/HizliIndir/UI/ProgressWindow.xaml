<Window x:Class="HizliIndir.UI.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HizliIndir.UI"
        Title="İndiriliyor" Width="620" MinWidth="520" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" Topmost="False">
    <DockPanel Margin="18">
        <Border Style="{StaticResource PillGroup}" DockPanel.Dock="Top" Margin="0,0,0,14" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Pill}" Content="İndirme durumu" GroupName="pt" IsChecked="True" Tag="0" Checked="Tab_Checked"/>
                <RadioButton Style="{StaticResource Pill}" Content="Hız sınırı" GroupName="pt" Tag="1" Checked="Tab_Checked"/>
                <RadioButton Style="{StaticResource Pill}" Content="Bitince" GroupName="pt" Tag="2" Checked="Tab_Checked"/>
            </StackPanel>
        </Border>

        <DockPanel x:Name="ActionBar" DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button x:Name="ToggleBtn" Content="Ayrıntılar &gt;&gt;" Click="Toggle_Click" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PauseBtn" Content="Duraklat" Width="110" Margin="0,0,8,0" Click="Pause_Click"/>
                <Button Content="İptal" Width="90" Click="Cancel_Click"/>
            </StackPanel>
        </DockPanel>

        <StackPanel x:Name="DetailsPanel" DockPanel.Dock="Bottom" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="DetailsHeader" Text="Bağlantıların başlangıç noktaları ve ilerlemesi" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
            <local:SegmentBar x:Name="Segments" Height="22" Margin="0,0,0,10"/>
            <Border Style="{StaticResource Card}" Padding="0" MaxHeight="220">
                <ListView x:Name="ConnList" BorderThickness="0" Background="Transparent"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          FontSize="12">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="No." Width="48" DisplayMemberBinding="{Binding No}"/>
                            <GridViewColumn Header="İnen (KB)" Width="110" DisplayMemberBinding="{Binding DownloadedKb}"/>
                            <GridViewColumn Header="Bilgi" Width="380" DisplayMemberBinding="{Binding Info}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </StackPanel>

        <Grid>
            <Border x:Name="StatusTab" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Adres" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="UrlText" Grid.Column="1" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" FontSize="12" Cursor="Hand" MouseLeftButtonUp="Url_Click"/>
                        <TextBlock Grid.Row="1" Text="Durum" Style="{StaticResource Caption}" Margin="0,6,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StateText" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                        <TextBlock Grid.Row="2" Text="Dosya boyutu" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="SizeText" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="3" Text="İnen" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="DoneText" Grid.Row="3" Grid.Column="1" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="4" Text="Aktarım hızı" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="SpeedText" Grid.Row="4" Grid.Column="1" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="5" Text="Kalan süre" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="EtaText" Grid.Row="5" Grid.Column="1" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="6" Text="Devam ettirilebilir" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="ResumeText" Grid.Row="6" Grid.Column="1" Margin="0,6,0,0"/>
                    </Grid>
                    <ProgressBar x:Name="Bar" Maximum="100" Height="10" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <Border x:Name="LimitTab" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <CheckBox x:Name="OwnLimitBox" Content="Bu indirme için hız sınırını aç" Checked="Limit_Changed" Unchecked="Limit_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="28,10,0,0">
                        <TextBox x:Name="OwnLimitValue" Width="100" Text="1024" TextChanged="Limit_Changed"/>
                        <TextBlock Text="KB/sn" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Değişiklik hemen uygulanır. Video indirmelerde genel hız sınırı yt-dlp üzerinden uygulanır."
                               Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border x:Name="AfterTab" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <CheckBox x:Name="AfterShowDialog" Content="Tamamlandı penceresini göster" IsChecked="True" Margin="0,0,0,6"/>
                    <CheckBox x:Name="AfterOpen" Content="Dosyayı aç" Margin="0,0,0,6"/>
                    <CheckBox x:Name="AfterReveal" Content="Klasörü aç" Margin="0,0,0,6"/>
                    <CheckBox x:Name="AfterExitApp" Content="Hızlı İndir'i kapat" Margin="0,0,0,6"/>
                    <CheckBox x:Name="AfterSleep" Content="Bilgisayarı uyut" Margin="0,0,0,6"/>
                    <CheckBox x:Name="AfterShutdown" Content="Bilgisayarı kapat"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
