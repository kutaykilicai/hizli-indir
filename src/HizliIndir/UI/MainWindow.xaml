<Window x:Class="HizliIndir.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HizliIndir.UI"
        Title="Hızlı İndir" Width="1180" Height="720" MinWidth="860" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="SideTemplate">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" HorizontalAlignment="Left" Foreground="{StaticResource Accent}"/>
                <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Kenar çubuğu -->
        <DockPanel Margin="12,12,6,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,2,0,16">
                <Image Source="pack://application:,,,/Assets/app.ico" Width="28" Height="28"/>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Hızlı İndir" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SideSpeed" Text="Boşta" Style="{StaticResource Caption}"/>
                </StackPanel>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Kategoriler" Style="{StaticResource Caption}" Margin="10,0,0,4" FontWeight="SemiBold"/>
                    <ListBox x:Name="CategoryList" Style="{StaticResource SideList}" ItemTemplate="{StaticResource SideTemplate}" SelectionChanged="Side_Changed"/>
                    <TextBlock Text="Durum" Style="{StaticResource Caption}" Margin="10,14,0,4" FontWeight="SemiBold"/>
                    <ListBox x:Name="StatusList" Style="{StaticResource SideList}" ItemTemplate="{StaticResource SideTemplate}" SelectionChanged="Side_Changed"/>
                    <Grid Margin="10,14,0,4">
                        <TextBlock Text="Kuyruklar" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
                        <Button Style="{StaticResource IconButton}" Tag="&#xE710;" HorizontalAlignment="Right" Margin="0,-8,0,-8" ToolTip="Kuyrukları ve zamanlayıcıyı yönet" Click="Scheduler_Click"/>
                    </Grid>
                    <ListBox x:Name="QueueList" Style="{StaticResource SideList}" ItemTemplate="{StaticResource SideTemplate}" SelectionChanged="Side_Changed"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <Grid Grid.Column="1" Margin="6,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Araç çubuğu -->
            <Border Style="{StaticResource Card}" Padding="6" CornerRadius="12">
                <DockPanel LastChildFill="False">
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE710;" Content="Adres ekle" Click="Add_Click" ToolTip="Yeni indirme (Ctrl+N)" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE896;" Content="Torrent" Click="Torrent_Click" ToolTip=".torrent dosyası aç. Magnet bağlantısı için Adres ekle'yi kullanın."/>
                    <Button x:Name="ResumeBtn" Style="{StaticResource ToolButton}" Tag="&#xE768;" Content="Devam" Click="Resume_Click"/>
                    <Button x:Name="StopBtn" Style="{StaticResource ToolButton}" Tag="&#xE769;" Content="Durdur" Click="Stop_Click"/>
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE71A;" Content="Tümünü durdur" Click="StopAll_Click"/>
                    <Button x:Name="DeleteBtn" Style="{StaticResource ToolButton}" Tag="&#xE74D;" Content="Sil" Click="Delete_Click"/>
                    <Border Width="1" Margin="6,6" Background="{DynamicResource Border}"/>
                    <Button x:Name="QueueBtn" Style="{StaticResource ToolButton}" Tag="&#xE8FD;" Content="Kuyruğu başlat" Click="Queue_Click"/>
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE823;" Content="Zamanlayıcı" Click="Scheduler_Click"/>
                    <Button x:Name="LimitBtn" Style="{StaticResource ToolButton}" Tag="&#xEC4A;" Content="Hız sınırı" Click="Limit_Click"/>
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE774;" Content="Site tarayıcı" Click="Grabber_Click"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Tag="&#xE713;" Content="Ayarlar" Click="Settings_Click"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Tag="&#xE8B3;" Content="Toplu" Click="Batch_Click" ToolTip="Sıralı adlardan toplu indirme"/>
                </DockPanel>
            </Border>

            <!-- Başlık ve filtre -->
            <DockPanel Grid.Row="1" Margin="4,14,4,10">
                <TextBlock x:Name="ViewTitle" Text="Tümü" Style="{StaticResource Title}" VerticalAlignment="Center"/>
                <Border DockPanel.Dock="Right" Width="230" Height="32" CornerRadius="16" Background="{DynamicResource PillBg}">
                    <Grid>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Left" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Margin="30,0,8,0" TextChanged="Search_Changed" MinHeight="0" Padding="0"/>
                        <TextBlock Text="Ara" Margin="34,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiary}" IsHitTestVisible="False" x:Name="SearchHint"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource PillGroup}" Margin="18,0,12,0" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Pill}" Content="Hepsi" GroupName="f" IsChecked="True" Tag="all" Checked="Filter_Checked"/>
                        <RadioButton Style="{StaticResource Pill}" Content="Etkin" GroupName="f" Tag="active" Checked="Filter_Checked"/>
                        <RadioButton Style="{StaticResource Pill}" Content="Bekleyen" GroupName="f" Tag="waiting" Checked="Filter_Checked"/>
                        <RadioButton Style="{StaticResource Pill}" Content="Hatalı" GroupName="f" Tag="error" Checked="Filter_Checked"/>
                    </StackPanel>
                </Border>
                <Grid/>
            </DockPanel>

            <!-- İndirme listesi -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
                <Grid>
                    <ListView x:Name="List" SelectionMode="Extended" MouseDoubleClick="List_DoubleClick" SelectionChanged="List_SelectionChanged" KeyDown="List_KeyDown"
                              AllowDrop="True" Drop="List_Drop" DragOver="List_DragOver">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Dosya adı" Width="360">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4,0">
                                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Selected}">
                                                    <TextBlock Text="{Binding Category, Converter={x:Static local:Converters.CategoryGlyph}}" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Accent}"/>
                                                </Border>
                                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="Medium" MaxWidth="300"/>
                                                    <TextBlock Text="{Binding Url}" Style="{StaticResource Caption}" FontSize="11" MaxWidth="300"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Boyut" Width="90">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeText}" Margin="6,0"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Durum" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="6,0" Width="180">
                                                <TextBlock Text="{Binding StatusText}" FontSize="12"/>
                                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Hız" Width="100">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SpeedText}" Margin="6,0"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Kalan" Width="90">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding EtaText}" Margin="6,0"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Eklenme" Width="120">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding AddedAt, StringFormat='dd.MM.yyyy HH:mm'}" Margin="6,0" Style="{StaticResource Caption}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                        <ListView.ContextMenu>
                            <ContextMenu x:Name="ItemMenu" Opened="ItemMenu_Opened">
                                <MenuItem Header="Aç" Click="Open_Click"/>
                                <MenuItem Header="Klasörü göster" Click="Reveal_Click"/>
                                <Separator/>
                                <MenuItem Header="Devam et" Click="Resume_Click"/>
                                <MenuItem Header="Durdur" Click="Stop_Click"/>
                                <MenuItem Header="Göster" Click="Progress_Click"/>
                                <MenuItem Header="Yeniden indir" Click="Redownload_Click"/>
                                <MenuItem x:Name="MoveMenu" Header="Kuyruğa taşı"/>
                                <Separator/>
                                <MenuItem Header="Adresi kopyala" Click="CopyUrl_Click"/>
                                <MenuItem Header="Özellikler" Click="Properties_Click"/>
                                <Separator/>
                                <MenuItem Header="Listeden sil" Click="Delete_Click"/>
                                <MenuItem Header="Dosyayla birlikte sil" Click="DeleteWithFile_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="40" Foreground="{DynamicResource TextTertiary}"/>
                        <TextBlock Text="Burada henüz indirme yok" HorizontalAlignment="Center" Margin="0,12,0,4" FontWeight="SemiBold"/>
                        <TextBlock Text="Adres ekleyin, bir bağlantıyı buraya sürükleyin ya da tarayıcıdan indirin." Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Durum çubuğu -->
            <DockPanel Grid.Row="3" Margin="8,10,8,0">
                <TextBlock x:Name="StatusLeft" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="StatusRight" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
