<Window x:Class="HizliIndir.UI.AddTorrentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Torrent ekle" Width="640" Height="540" MinWidth="520" MinHeight="420" WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Topmost="True">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Grid x:Name="Root" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource Selected}" Margin="0,0,14,0">
                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource Accent}"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Heading" Text="Torrent ekle" Style="{StaticResource Title}" FontSize="18"/>
                <TextBlock x:Name="SubText" Text="Dosya bilgisi alınıyor" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="4">
            <Grid>
                <StackPanel x:Name="Waiting" VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
                    <ProgressBar IsIndeterminate="True" Height="4"/>
                    <TextBlock Text="Eşlerden dosya listesi isteniyor" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="Bu birkaç saniye ile birkaç dakika arasında sürebilir." Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <DockPanel x:Name="FilesPanel" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Margin="10,8,10,6">
                        <TextBlock x:Name="SelText" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="AllBox" Content="Tümünü seç" IsChecked="True" Click="All_Click"/>
                    </DockPanel>
                    <ListView x:Name="FileList" BorderThickness="0" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Click="File_Click" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Path}" Margin="6,0,8,0" VerticalAlignment="Center" ToolTip="{Binding Path}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Kayıt yeri" Style="{StaticResource Caption}" VerticalAlignment="Center" Width="80"/>
            <Button DockPanel.Dock="Right" Content="Gözat" Margin="8,0,0,0" Click="Browse_Click"/>
            <TextBox x:Name="FolderBox"/>
        </DockPanel>

        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="330"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Vazgeç" IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="StartBtn" Content="İndirmeyi başlat" IsDefault="True" IsEnabled="False" Style="{StaticResource AccentButton}" Click="Start_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
