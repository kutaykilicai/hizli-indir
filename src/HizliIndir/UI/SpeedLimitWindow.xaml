<Window x:Class="HizliIndir.UI.SpeedLimitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hız sınırı" Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="Hız sınırı" Style="{StaticResource Title}" FontSize="18"/>
        <TextBlock Text="Varsayılan olarak hız sınırı yoktur ve indirmeler hattın verdiği en yüksek hızda yapılır." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,14"/>
        <Border Style="{StaticResource PillGroup}">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="OffPill" Style="{StaticResource Pill}" Content="Sınırsız" GroupName="l"/>
                <RadioButton x:Name="OnPill" Style="{StaticResource Pill}" Content="Sınırla" GroupName="l"/>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0" IsEnabled="{Binding IsChecked, ElementName=OnPill}">
            <TextBlock Text="Toplam en fazla" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="ValueBox" Width="90"/>
            <TextBlock Text="KB/sn" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
        <CheckBox x:Name="StartupBox" Content="Program açılınca hız sınırını hep aç" Margin="0,12,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Vazgeç" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Tamam" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
