<Window x:Class="HizliIndir.UI.CompleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İndirme tamamlandı" Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True">
    <StackPanel Margin="20">
        <DockPanel>
            <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource Success}" Margin="0,0,14,0">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="20" Foreground="White"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="İndirme tamamlandı" Style="{StaticResource Title}" FontSize="18"/>
                <TextBlock x:Name="Summary" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock x:Name="NameText" FontWeight="SemiBold"/>
                <TextBlock x:Name="PathText" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="Finalize" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <CheckBox x:Name="NeverBox" Content="Bu pencereyi bir daha gösterme" Margin="0,12,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Klasörü aç" Margin="0,0,8,0" Click="Folder_Click"/>
            <Button Content="Aç" Margin="0,0,8,0" Click="Open_Click" IsDefault="True"/>
            <Button Content="Kapat" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
