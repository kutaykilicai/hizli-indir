<Window x:Class="HizliIndir.UI.GrabberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Site tarayıcı" Width="860" Height="620" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="Head" Text="Site tarayıcı" Style="{StaticResource Title}"/>
            <TextBlock x:Name="Sub" Text="Bir sayfadaki ve bağlı sayfalardaki dosyaları bulup seçtiklerinizi indirir." Style="{StaticResource Caption}" Margin="0,4,0,12"/>
            <Border x:Name="ScanCard" Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBox x:Name="UrlBox" Margin="0,0,10,0"/>
                    <Button x:Name="ScanBtn" Grid.Column="1" Content="Tara" Style="{StaticResource AccentButton}" Click="Scan_Click"/>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Derinlik" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="DepthBox" Width="70"/>
                        <TextBlock Text="Uzantılar" VerticalAlignment="Center" Margin="16,0,8,0"/>
                        <TextBox x:Name="ExtBox" Width="260"/>
                        <CheckBox x:Name="SameSite" Content="Yalnızca bu site" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Tümünü seç" Margin="0,0,8,0" Click="All_Click"/>
                <Button Content="Hiçbirini seçme" Click="None_Click"/>
                <TextBlock x:Name="Status" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="320"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ComboBox x:Name="QueueBox" Width="150" DisplayMemberPath="Name" Margin="0,0,8,0"/>
                <Button Content="Kuyruğa ekle" Margin="0,0,8,0" Click="Queue_Click"/>
                <Button Content="Seçilenleri indir" IsDefault="True" Click="Download_Click"/>
            </StackPanel>
        </DockPanel>
        <Border Style="{StaticResource Card}" Padding="4">
            <ListView x:Name="Results">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="40">
                            <GridViewColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected}" Margin="6,0,0,0"/></DataTemplate></GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Dosya" Width="260" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Tür" Width="60" DisplayMemberBinding="{Binding Ext}"/>
                        <GridViewColumn Header="Adres" Width="430" DisplayMemberBinding="{Binding Url}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</Window>
